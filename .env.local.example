# Dignity Institutional Platform — Local Development Environment
# Copy this to .env.local and populate with your local values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5433/dignity_institutional

# NextAuth
NEXTAUTH_URL=http://localhost:3300
NEXTAUTH_SECRET=your-32-byte-base64-secret-here

# Node Environment
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5100
AGENT_BACKEND_URL=http://localhost:5100

# Cloudflare (for production)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_PAGES_PROJECT=dignity-institutional

# Feature Flags
ENABLE_ADMIN_PANEL=true
ENABLE_INVESTOR_PORTAL=true
ENABLE_MCP_TOOLS=true
